<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#5AAFF2">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="108dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="104dp"
        android:background="@drawable/live_clock_panel"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingEnd="16dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="end"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="yyyy. MMMM d., EEEE"
            android:format24Hour="yyyy. MMMM d., EEEE"
            android:gravity="end"
            android:shadowColor="#55000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="252dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <View
            android:id="@+id/youtubeButton"
            android:layout_width="220dp"
            android:layout_height="205dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/card_hotspot"
            android:clickable="true"
            android:contentDescription="YouTube"
            android:focusable="true" />

        <View
            android:id="@+id/disneyButton"
            android:layout_width="220dp"
            android:layout_height="205dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/card_hotspot"
            android:clickable="true"
            android:contentDescription="Disney+"
            android:focusable="true" />

        <View
            android:id="@+id/netflixButton"
            android:layout_width="220dp"
            android:layout_height="205dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/card_hotspot"
            android:clickable="true"
            android:contentDescription="Netflix"
            android:focusable="true" />

        <View
            android:id="@+id/maxButton"
            android:layout_width="220dp"
            android:layout_height="205dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/card_hotspot"
            android:clickable="true"
            android:contentDescription="Max / HBO Max"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:id="@+id/settingsButton"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/settings_hotspot"
        android:clickable="true"
        android:contentDescription="@string/settings"
        android:focusable="true" />

</FrameLayout>
